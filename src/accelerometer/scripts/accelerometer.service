# Piggybacks on canalyzer.service, which owns InfluxDB and Grafana.
# Install on the Pi (after canalyzer.service is installed):
#   sudo cp accelerometer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now accelerometer.service
# Paths assume the repo is cloned to /home/mrover/mrover-esw, edit if not.

[Unit]
Description=MRover Accelerometer Docker Compose Stack
# Pull canalyzer in and stop/restart with it, but do NOT order After= it.
# canalyzer.service is Type=oneshot with an ExecStart that never returns (sleep infinity),
# so it stays "activating" forever and an After= dependency would block this unit indefinitely.
# Readiness is handled by init_influx.sh instead, which waits for canalyzer's influxdb
# container to report healthy before the accelerometer stack is brought up.
Requires=canalyzer.service docker.service
After=docker.service
PartOf=canalyzer.service

[Service]
Type=oneshot
RemainAfterExit=yes

WorkingDirectory=/home/mrover/mrover-esw/src/accelerometer

ExecStart=/home/mrover/mrover-esw/src/accelerometer/scripts/pi_start.sh
ExecStop=/home/mrover/mrover-esw/src/accelerometer/scripts/pi_stop.sh

# init_influx.sh bounds the wait on influxdb (120s), leave headroom for compose up
TimeoutStartSec=180
TimeoutStopSec=30

# Retry if influxdb wasn't healthy in time (e.g. slow cold boot pulling images)
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target canalyzer.service
